generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model CustomerUser {
  id           String         @id @default(cuid())
  email        String         @unique
  password     String
  name         String
  phone        String?
  cpfCnpj      String?
  street       String?
  number       String?
  neighborhood String?
  city         String?
  state        String?
  zipCode      String?
  blingContatoId String?
  orders       Order[]
  wishlist     WishlistItem[]
  reviews      ProductReview[]
  returns      Return[]
  creditAdjustments CreditAdjustment[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  image     String?
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
}

model PackagePreset {
  id           String    @id @default(cuid())
  name         String
  comprimento  Int
  largura      Int
  altura       Int
  pesoGramas   Int       @default(0)
  active       Boolean   @default(true)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id           String          @id @default(cuid())
  name         String
  description  String?         @db.Text
  price        Float
  comparePrice Float?
  costPrice    Float?
  images       String          @db.Text
  categoryId   String
  category     Category        @relation(fields: [categoryId], references: [id])
  sizes        String          @db.Text
  colors       String          @db.Text
  attributes   String          @db.Text
  stock        Int             @default(0)
  variantStock String          @db.Text
  pesoGramas   Int?
  embalagemId  String?
  embalagem    PackagePreset?  @relation(fields: [embalagemId], references: [id])
  blingProdutoId String?
  active       Boolean         @default(true)
  featured     Boolean         @default(false)
  slug         String          @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  orderItems   OrderItem[]
  wishlist     WishlistItem[]
  navItems     NavItem[]
  reviews      ProductReview[]
  waitlist     WaitlistEntry[]
  flashSales   FlashSale[]
  variantBlingMaps ProductVariantBlingMap[]
  /** Medidas/tabela de tamanhos em texto livre (usado na página do produto e pelo atendente de IA) */
  measurements String?         @db.Text

  @@index([active, createdAt])
  @@index([active, price])
  @@index([active, name])
}

model ProductVariantBlingMap {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size            String   // "P", "M", "G", "GG", etc
  blingProdutoId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, size])
  @@index([productId])
}

model WishlistItem {
  id         String       @id @default(cuid())
  customerId String
  customer   CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([customerId, productId])
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  customerName     String
  customerEmail    String?
  customerPhone    String
  address          String?
  streetNumber     String?
  neighborhood     String?
  city             String?
  state            String?
  zipCode          String?
  cpfCnpj          String?
  items            OrderItem[]
  subtotal         Float
  shippingCost     Float         @default(0)
  shippingMethod   String?
  total            Float
  status           String        @default("PENDING")
  cancelReason     String?       @db.Text
  trackingCode     String?
  shippingProof    String?
  notes            String?       @db.Text
  customerId       String?
  customer         CustomerUser? @relation(fields: [customerId], references: [id])
  returns          Return[]
  paymentGateway   String?
  paymentId        String?
  paymentMethod    String?
  paymentFee       Float         @default(0)
  /** pix | credit_card | debit_card | boleto | account_money (quando o gateway informa) */
  paymentType      String?
  paymentInstallments Int?
  /** Valor líquido recebido, informado pelo gateway (null = taxa não conferida) */
  paymentNetAmount Float?
  /** Quando o pedido foi entregue/retirado — base do prazo de devolução (CDC art. 49) */
  deliveredAt      DateTime?
  /** Quanto a loja pagou pela etiqueta no Melhor Envio (para medir frete subsidiado) */
  shippingLabelCost Float?
  refundedAt       DateTime?
  returnStatus     String?       // PARTIAL_RETURN, FULL_RETURN
  reviewEmailSentAt DateTime?
  stockDecrementedAt DateTime?   // set when stock was taken for this order (see commitOrderStock)
  upsellEmailSentAt DateTime?

  // Melhor Envio integration
  melhorEnvioShipmentId    String?
  trackingUrl              String?
  shipmentStatus           String?       @default("pending")
  lastTrackingUpdate       DateTime?
  etiquetaUrl              String?
  // Etiqueta pronta para imprimir (Melhor Envio: pagar → gerar → imprimir)
  /** PDF da etiqueta salvo no servidor (pasta privada) */
  labelFile                String?
  /** Link público de impressão do Melhor Envio (alternativa ao PDF salvo) */
  labelPrintUrl            String?       @db.Text
  labelGeneratedAt         DateTime?
  labelPrintedAt           DateTime?
  /** Erro na etapa pagar/gerar/imprimir (ex.: saldo insuficiente) — some quando dá certo */
  labelStepError           String?       @db.Text
  labelStepAttempts        Int           @default(0)
  labelLastAttemptAt       DateTime?
  /** Quando o dono da loja viu o pedido no aviso de "novos pedidos" do admin (null = novo) */
  adminSeenAt              DateTime?

  // Cashback (crédito na conta do cliente)
  /** Crédito da conta usado como desconto neste pedido */
  creditUsed               Float         @default(0)
  /** Cashback prometido por este pedido (já calculado com a % da época); libera após entrega + prazo */
  cashbackEarned           Float         @default(0)
  cashbackReleaseEmailAt   DateTime?
  cashbackExpiryEmailAt    DateTime?
  trackingEvents           TrackingEvent[]
  labelValidatedAt         DateTime?
  labelValid               Boolean?
  labelError               String?       @db.Text

  // Shipment retry mechanism
  shipmentAttempts         Int           @default(0)
  lastShipmentAttempt      DateTime?
  shipmentRetryError       String?       @db.Text
  shipmentRetryableError   Boolean?      @default(false)

  // Cupom de desconto (valor total do cupom, incluindo frete grátis)
  couponCode               String?
  couponDiscount           Float         @default(0)

  // Bling integration
  blingPedidoId            String?
  blingIntegrationStatus   String?       @default("pending")
  blingIntegratedAt        DateTime?

  // Nota fiscal (NF-e emitida pelo Bling a partir do pedido)
  /** ID da nota no Bling */
  nfeId                    String?
  /** processing | authorized | rejected | denied | cancelled | error */
  nfeStatus                String?
  /** Situação numérica do Bling (1 pendente … 5 autorizada, 4 rejeitada) */
  nfeSituacao              Int?
  nfeNumero                String?
  nfeSerie                 String?
  nfeChave                 String?
  /** Motivo da rejeição / erro, como veio do Bling/SEFAZ */
  nfeError                 String?       @db.Text
  nfeAttempts              Int           @default(0)
  nfeAuthorizedAt          DateTime?
  nfeLastCheckAt           DateTime?
  nfeEmailSentAt           DateTime?
  /** Nota já emitida no Bling e só vinculada ao pedido pelo admin (não envia e-mail sozinho) */
  nfeImportedAt            DateTime?

  // Meta Ads (Pixel + Conversions API): browser context captured at checkout,
  // only when the buyer accepted marketing cookies (LGPD)
  metaConsent              Boolean       @default(false)
  metaFbp                  String?
  metaFbc                  String?       @db.Text
  clientIp                 String?
  clientUserAgent          String?       @db.Text
  metaPurchaseSentAt       DateTime?

  // Traffic source that brought the customer (last identified source, 30 days)
  trafficChannel           String?
  utmSource                String?
  utmMedium                String?
  utmCampaign              String?
  utmContent               String?
  utmTerm                  String?
  trafficReferrer          String?
  landingPage              String?       @db.Text

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([couponCode])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([customerEmail])
  @@index([nfeStatus])
  @@index([adminSeenAt, status])
  @@index([customerId, status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  size               String?
  color              String?
  selectedAttributes String? @db.Text
  blingProdutoId     String?
}

model NavItem {
  id        String    @id @default(cuid())
  label     String
  href      String
  active    Boolean   @default(true)
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  products  Product[]
}

model CompanySettings {
  id                     String   @id @default(cuid())
  name                   String   @default("Minha Loja")
  logo                   String?
  phone                  String?
  whatsapp               String?
  instagram              String?
  address                String?
  cnpj                   String?
  description            String?  @db.Text
  primaryColor           String   @default("#ec4899")
  buttonColor            String   @default("#ec4899")
  menuColor              String   @default("#ec4899")
  bannerImages           String   @db.Text
  checkoutType           String   @default("whatsapp")
  checkoutCollectEmail   Boolean  @default(false)
  checkoutCollectAddress Boolean  @default(false)
  checkoutMessage        String?  @db.Text
  mercadoPagoPublicKey   String?
  mercadoPagoAccessToken String?
  nuPayClientId          String?  // NuPay Merchant Key
  nuPayClientSecret      String?  @db.Text // NuPay Merchant Token
  heroBadge              String?
  heroTitle              String?
  heroButtonText         String?
  heroButtonSecondaryText String?
  freteAtivo             Boolean  @default(false)
  freteTipo              String   @default("fixo")
  freteValorFixo         Float    @default(0)
  freteCEPOrigem         String?
  fretePesoDefaultGramas Int      @default(500)
  melhorEnvioToken       String?  @db.Text
  melhorEnvioApiToken    String?  @db.Text
  melhorEnvioWebhookSecret String? @db.Text
  metaPixelId            String?
  metaCapiAccessToken    String?  @db.Text
  metaTestEventCode      String?
  // AI customer support assistant (Claude API)
  aiAssistantEnabled     Boolean  @default(false)
  aiApiKey               String?  @db.Text
  aiModel                String   @default("claude-opus-5-5")
  aiPolicies             String?  @db.Text
  aiDailyMessageLimit    Int      @default(300)
  fretePacoteAltura      Int      @default(5)
  fretePacoteLargura     Int      @default(12)
  fretePacoteComprimento Int      @default(17)
  freteLocalCidade       String?
  freteLocalUF           String?
  freteLocalRegioes      String?
  freteLocalRetirada     Boolean  @default(false)
  mercadoPagoAtivo       Boolean  @default(false)
  mercadoPagoTransparente Boolean @default(false) // card/Pix form inside the site (Payment Brick)
  nuPayAtivo             Boolean  @default(false)
  nuPaySandbox           Boolean  @default(false) // NuPay sandbox environment (tests)
  infinityPayAtivo       Boolean  @default(false)
  infinityPayHandle      String?
  infinityPayApiKey      String?  @db.Text
  whatsappAtivo          Boolean  @default(false)
  pixDiscountEnabled     Boolean  @default(false)
  pixDiscountPercent     Float    @default(0)
  blingAtivo             Boolean  @default(false)
  blingClientId          String?  @db.Text
  blingClientSecret      String?  @db.Text
  blingAccessToken       String?  @db.Text
  blingRefreshToken      String?  @db.Text
  blingTokenExpiresAt    DateTime?
  /** Emite a NF-e automaticamente assim que o pedido pago entra no Bling */
  blingNfeAuto           Boolean  @default(false)
  /** Alíquota de imposto sobre vendas (%), ex.: alíquota efetiva do Simples Nacional (DAS). Entra no DRE/lucro. */
  salesTaxRate           Float?

  // Cashback: % da compra vira crédito para as próximas compras
  cashbackEnabled        Boolean  @default(false)
  cashbackPercent        Float    @default(5)
  /** Dias depois da entrega para liberar (prazo de devolução) */
  cashbackReleaseDays    Int      @default(7)
  /** Validade do crédito em dias, contada da liberação */
  cashbackValidityDays   Int      @default(90)
  /** Quanto do pedido (produtos, após descontos) o crédito pode pagar, em % */
  cashbackMaxUsePercent  Float    @default(50)
  /** Valor mínimo em produtos para poder usar o crédito */
  cashbackMinOrder       Float    @default(0)
  /** Crédito pode ser usado junto com cupom */
  cashbackStackCoupon    Boolean  @default(false)
  /** Crédito pode ser usado junto com o desconto Pix */
  cashbackStackPix       Boolean  @default(true)
  diasUteisProduzao      Int      @default(2)
  updatedAt              DateTime @updatedAt
  /** Meta de faturamento do mês (R$), exibida no dashboard */
  monthlyRevenueGoal Float?
}

model ProductReview {
  id         String        @id @default(cuid())
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int
  comment    String?       @db.Text
  photoUrl   String?       @db.Text
  approved   Boolean       @default(false)
  createdAt  DateTime      @default(now())
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  email     String
  name      String?
  size       String   @default("") @db.VarChar(100)
  color      String   @default("") @db.VarChar(100)
  variantKey String   @default("") @db.VarChar(191)
  notified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([productId, email, variantKey])
  @@unique([productId, email, size, color])
}

model VariationTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  values    String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AbandonedCart {
  id           String   @id @default(cuid())
  customerId   String?
  email        String   @unique
  cartItems    String   @db.Text
  reminderSent Boolean  @default(false)
  /** Quando o lembrete foi enviado (manual ou automático) */
  reminderSentAt DateTime?
  /** Cliente finalizou/esvaziou o carrinho depois do lembrete (guardado para medir recuperação) */
  closedAt     DateTime?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model FlashSale {
  id            String   @id @default(cuid())
  title         String
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  discountType  String   @default("PERCENT")
  discountValue Float
  startAt       DateTime
  endAt         DateTime
  active        Boolean  @default(true)
  notifySent    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([startAt, endAt])
  @@index([active])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  type       String
  productId  String?
  sessionId  String?
  customerId String?
  orderId    String?
  path       String?
  value      Float?
  // Traffic source of the session (see src/lib/trafficSource.ts)
  channel     String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt  DateTime @default(now())

  @@index([type, createdAt])
  @@index([productId, type])
  @@index([sessionId])
}

model TrackingEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  location  String?
  timestamp DateTime
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([orderId, timestamp])
}

model Return {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId      String
  customer        CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)
  returnedItems   Json?
  reason          String   @db.Text
  // PENDING → AWAITING_RETURN (código de postagem enviado ao cliente) → APPROVED | REJECTED
  status          String   @default("PENDING")
  trackingCode    String?
  labelSentAt     DateTime?
  adminNotes      String?  @db.Text
  images          String?  @db.Text
  refundAmount    Float    @default(0)
  refundedAt      DateTime?
  responseDate    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

// AI support assistant: one row per chat. `system` is frozen when the chat starts and
// `messages` is append-only (required by the Claude API to keep thinking blocks valid).
model AiConversation {
  id              String   @id @default(cuid())
  customerId      String?
  model           String
  system          String   @db.LongText
  messages        Json
  userMessages    Int      @default(0)
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  cacheReadTokens Int      @default(0)
  handedOff       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
}

// Daily usage of the AI assistant (day in America/Sao_Paulo, YYYY-MM-DD)
model AiUsageDay {
  day              String @id
  messages         Int    @default(0)
  inputTokens      Int    @default(0)
  outputTokens     Int    @default(0)
  cacheReadTokens  Int    @default(0)
  cacheWriteTokens Int    @default(0)
}

model Coupon {
  id                String    @id @default(cuid())
  /** Sempre em maiúsculas; o cliente pode digitar de qualquer jeito */
  code              String    @unique
  description       String?
  /** PERCENT | FIXED | FREE_SHIPPING */
  type              String    @default("PERCENT")
  value             Float     @default(0)
  /** Teto do desconto para cupons de porcentagem */
  maxDiscount       Float?
  minOrderValue     Float?
  startsAt          DateTime?
  endsAt            DateTime?
  /** Usos totais (pedidos pagos + reservas recentes); null = ilimitado */
  usageLimit        Int?
  /** Usos por cliente (CPF/e-mail/conta); null = ilimitado */
  perCustomerLimit  Int?      @default(1)
  firstPurchaseOnly Boolean   @default(false)
  stackWithPix      Boolean   @default(false)
  /** O atendente de IA pode oferecer este cupom aos clientes */
  showInChat        Boolean   @default(false)
  /** JSON com ids; vazio/null = vale para tudo */
  productIds        String?   @db.Text
  categoryIds       String?   @db.Text
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([active])
}

/** Ajuste manual de crédito feito pelo dono da loja (cortesia, correção). Positivo = dá crédito; negativo = retira. */
model CreditAdjustment {
  id         String       @id @default(cuid())
  customerId String
  customer   CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount     Float
  reason     String
  createdBy  String?
  /** Validade do crédito dado (null = validade padrão das configurações) */
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())

  @@index([customerId])
}
