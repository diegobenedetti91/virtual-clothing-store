# Modelo de variáveis de ambiente — uma loja (cliente) por deploy.
# Guia completo: docs/IMPLANTACAO.md

# ── Obrigatórias ─────────────────────────────────────────────
# Banco MySQL da loja (um banco por cliente)
DATABASE_URL="mysql://usuario:senha@host:3306/nome_do_banco"

# Endereço público da loja (https, sem barra no final). Usado em links de e-mail, webhooks e SEO.
NEXTAUTH_URL="https://www.dominio-do-cliente.com.br"
NEXT_PUBLIC_SITE_URL="https://www.dominio-do-cliente.com.br"

# Segredo das sessões e dos links assinados. Gere com: openssl rand -hex 32  (um diferente por loja)
NEXTAUTH_SECRET="gere-uma-chave-forte-aqui"

# Senha das rotinas automáticas (cron). Gere com: openssl rand -hex 32  (uma diferente por loja)
CRON_SECRET="gere-outra-chave-forte-aqui"

# Admin inicial (o build cria/atualiza). Senha com 8+ caracteres.
# Para trocar a senha do admin depois: altere ADMIN_PASS e faça um novo deploy.
ADMIN_EMAIL="dono@dominio-do-cliente.com.br"
ADMIN_PASS=""
ADMIN_NAME="Nome do dono"

# Pasta FORA do projeto onde ficam as imagens enviadas (sobrevive aos deploys)
PERSISTENT_UPLOAD_DIR="/home/usuario/uploads-loja"

# E-mail da loja (SMTP) — confirmações, rastreio, nota fiscal, recuperação de senha
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@dominio-do-cliente.com.br
SMTP_PASS=senha-do-email

# ── Opcionais ────────────────────────────────────────────────
# Login com Google (mesmo valor nas duas)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Senha do webhook de vendas do Bling (?token=…)
BLING_WEBHOOK_TOKEN=

# Notificações push (OneSignal)
NEXT_PUBLIC_ONESIGNAL_APP_ID=
NEXT_PUBLIC_ONESIGNAL_SAFARI_ID=
