{
  "name": "virtual-clothing-store",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "npx ts-node --esm prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && (prisma migrate resolve --rolled-back 20260513000001_waitlist_size_color 2>/dev/null || true) && (prisma migrate resolve --rolled-back 20260514000001_dynamic_attributes 2>/dev/null || true) && prisma migrate deploy && node scripts/setup-admin.mjs && mkdir -p public/uploads && TOKIO_WORKER_THREADS=2 RAYON_NUM_THREADS=2 next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "seed": "ts-node --project tsconfig.json prisma/seed.ts",
    "seed:demo": "npx tsx prisma/seed-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@prisma/client": "^6.19.3",
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^1.14.0",
    "next": "^16.4.5",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^10.4.0",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
